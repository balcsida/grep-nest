{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "secrets",
    "breakGlass",
    "server",
    "node",
    "graph",
    "scanner",
    "migration",
    "ingress",
    "monitoring",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": {
      "$ref": "#/definitions/optionalDnsLabel"
    },
    "fullnameOverride": {
      "$ref": "#/definitions/optionalDnsLabel"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "node",
        "scanner",
        "pullSecrets"
      ],
      "properties": {
        "application": {
          "$ref": "#/definitions/image"
        },
        "node": {
          "$ref": "#/definitions/image"
        },
        "scanner": {
          "$ref": "#/definitions/optionalImage"
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/kubernetesObjectName"
          },
          "uniqueItems": true
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "githubApp",
        "customCA",
        "oidc",
        "githubOAuth",
        "oidcCA",
        "scim"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/definitions/runtimeSecret"
        },
        "githubApp": {
          "$ref": "#/definitions/githubSecret"
        },
        "customCA": {
          "$ref": "#/definitions/optionalSecret"
        },
        "oidc": {
          "$ref": "#/definitions/oidcSecret"
        },
        "githubOAuth": {
          "$ref": "#/definitions/oidcSecret"
        },
        "oidcCA": {
          "$ref": "#/definitions/optionalSecret"
        },
        "scim": {
          "$ref": "#/definitions/scimSecret"
        }
      }
    },
    "breakGlass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "port",
        "service",
        "config",
        "sso",
        "scim",
        "resources",
        "nodeSelector",
        "affinity",
        "tolerations",
        "topologySpreadConstraints",
        "podSecurityContext",
        "podAnnotations",
        "pdb"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "githubWebURL",
            "githubAPIURL",
            "githubUploadURL",
            "githubGitURL",
            "githubAPIVersion",
            "githubAppID",
            "defaultResults",
            "maxResults",
            "defaultContextLines",
            "maxContextLines",
            "defaultTimeout",
            "maxTimeout",
            "maxRequestBytes",
            "maxResponseBytes",
            "scipMaxUploadBytes"
          ],
          "properties": {
            "githubWebURL": {
              "$ref": "#/definitions/url"
            },
            "githubAPIURL": {
              "$ref": "#/definitions/url"
            },
            "githubUploadURL": {
              "$ref": "#/definitions/url"
            },
            "githubGitURL": {
              "$ref": "#/definitions/url"
            },
            "githubAPIVersion": {
              "type": "string",
              "minLength": 1
            },
            "githubAppID": {
              "$ref": "#/definitions/id"
            },
            "defaultResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "defaultContextLines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "maxContextLines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "defaultTimeout": {
              "$ref": "#/definitions/duration"
            },
            "maxTimeout": {
              "$ref": "#/definitions/duration"
            },
            "maxRequestBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "scipMaxUploadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            }
          }
        },
        "sso": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicURL", "sessionIdle", "sessionTTL", "loginFlowTTL", "oidc", "githubOAuth"],
          "properties": {
            "publicURL": {"type": "string"},
            "sessionIdle": {"$ref": "#/definitions/duration"},
            "sessionTTL": {"$ref": "#/definitions/duration"},
            "loginFlowTTL": {"$ref": "#/definitions/duration"},
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "issuerURL", "clientID", "scopes", "linkClaim", "displayNameClaim"],
              "properties": {
                "enabled": {"type": "boolean"},
                "issuerURL": {"type": "string"},
                "clientID": {"type": "string"},
                "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "openid"}, "items": {"$ref": "#/definitions/nonEmptyString"}},
                "linkClaim": {"type": "string"},
                "displayNameClaim": {"$ref": "#/definitions/nonEmptyString"}
              }
            },
            "githubOAuth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "clientID"],
              "properties": {
                "enabled": {"type": "boolean"},
                "clientID": {"type": "string"}
              }
            }
          }
        },
        "scim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/map"
        },
        "affinity": {
          "$ref": "#/definitions/map"
        },
        "tolerations": {
          "$ref": "#/definitions/array"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/array"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/map"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "minAvailable"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "const": 1
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "zoekt",
        "indexer",
        "paths",
        "service",
        "storage",
        "nodeSelector",
        "affinity",
        "tolerations",
        "topologySpreadConstraints",
        "podSecurityContext",
        "podAnnotations"
      ],
      "properties": {
        "replicaCount": {
          "const": 1
        },
        "zoekt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "executable",
            "resources"
          ],
          "properties": {
            "port": {
              "$ref": "#/definitions/port"
            },
            "executable": {
              "$ref": "#/definitions/path"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "indexer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "gitExecutable",
            "zoektGitIndexExecutable",
            "minFreeBytes",
            "maxRepositoryBytes",
            "metricsPort",
            "resources"
          ],
          "properties": {
            "executable": {
              "$ref": "#/definitions/path"
            },
            "gitExecutable": {
              "$ref": "#/definitions/path"
            },
            "zoektGitIndexExecutable": {
              "$ref": "#/definitions/path"
            },
            "minFreeBytes": {
              "$ref": "#/definitions/positiveInteger"
            },
            "maxRepositoryBytes": {
              "$ref": "#/definitions/positiveInteger"
            },
            "metricsPort": {
              "$ref": "#/definitions/port"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data",
            "indexes"
          ],
          "properties": {
            "data": {
              "$ref": "#/definitions/path"
            },
            "indexes": {
              "$ref": "#/definitions/path"
            }
          }
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "accessModes",
            "storageClassName",
            "annotations"
          ],
          "properties": {
            "size": {
              "$ref": "#/definitions/quantity"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "const": "ReadWriteOnce"
              }
            },
            "storageClassName": {
              "$ref": "#/definitions/optionalKubernetesObjectName"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "nodeSelector": {
          "$ref": "#/definitions/map"
        },
        "affinity": {
          "$ref": "#/definitions/map"
        },
        "tolerations": {
          "$ref": "#/definitions/array"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/array"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/map"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "executable", "port", "dataPath", "resources", "storage",
        "nodeSelector", "affinity", "tolerations", "podSecurityContext", "podAnnotations"
      ],
      "properties": {
        "mode": {"enum": ["embedded", "separate"]},
        "executable": {"$ref": "#/definitions/path"},
        "port": {"$ref": "#/definitions/port"},
        "dataPath": {"$ref": "#/definitions/path"},
        "resources": {"$ref": "#/definitions/resources"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "accessModes", "storageClassName", "annotations"],
          "properties": {
            "size": {"$ref": "#/definitions/quantity"},
            "accessModes": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {"const": "ReadWriteOnce"}
            },
            "storageClassName": {"$ref": "#/definitions/optionalKubernetesObjectName"},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        },
        "nodeSelector": {"$ref": "#/definitions/map"},
        "affinity": {"$ref": "#/definitions/map"},
        "tolerations": {"$ref": "#/definitions/array"},
        "podSecurityContext": {"$ref": "#/definitions/map"},
        "podAnnotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "replicas", "executable", "dataPath", "gitExecutable",
        "metricsPort", "resources", "nodeSelector", "affinity", "tolerations",
        "podSecurityContext", "podAnnotations"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 1},
        "executable": {"$ref": "#/definitions/path"},
        "dataPath": {"$ref": "#/definitions/path"},
        "gitExecutable": {"$ref": "#/definitions/path"},
        "metricsPort": {"$ref": "#/definitions/port"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/map"},
        "affinity": {"$ref": "#/definitions/map"},
        "tolerations": {"$ref": "#/definitions/array"},
        "podSecurityContext": {"$ref": "#/definitions/map"},
        "podAnnotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "backoffLimit",
        "activeDeadlineSeconds",
        "resources",
        "nodeSelector",
        "affinity",
        "tolerations"
      ],
      "properties": {
        "executable": {
          "$ref": "#/definitions/path"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "$ref": "#/definitions/positiveInteger"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/map"
        },
        "affinity": {
          "$ref": "#/definitions/map"
        },
        "tolerations": {
          "$ref": "#/definitions/array"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "$ref": "#/definitions/optionalKubernetesObjectName"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ingressHost"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ingressTLS"
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceMonitor"
      ],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "interval",
            "scrapeTimeout",
            "labels",
            "namespaceSelector"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "$ref": "#/definitions/duration"
            },
            "scrapeTimeout": {
              "$ref": "#/definitions/duration"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "namespaceSelector": {
              "$ref": "#/definitions/map"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "serverIngress",
        "externalEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serverIngress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingressControllerNamespaceSelector",
            "monitoringNamespaceSelector"
          ],
          "properties": {
            "ingressControllerNamespaceSelector": {
              "$ref": "#/definitions/optionalSelector"
            },
            "monitoringNamespaceSelector": {
              "$ref": "#/definitions/optionalSelector"
            }
          }
        },
        "externalEgress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "dns",
            "postgresql",
            "github",
            "identityProvider"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespaceSelector",
                "podSelector",
                "ports"
              ],
              "properties": {
                "namespaceSelector": {
                  "$ref": "#/definitions/optionalSelector"
                },
                "podSelector": {
                  "$ref": "#/definitions/optionalSelector"
                },
                "ports": {
                  "$ref": "#/definitions/ports"
                }
              }
            },
            "postgresql": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "$ref": "#/definitions/cidrs"
                },
                "port": {
                  "$ref": "#/definitions/port"
                }
              }
            },
            "github": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "ports"
              ],
              "properties": {
                "cidrs": {
                  "$ref": "#/definitions/cidrs"
                },
                "ports": {
                  "$ref": "#/definitions/ports"
                }
              }
            },
            "identityProvider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cidrs", "ports"],
              "properties": {
                "cidrs": {"$ref": "#/definitions/cidrs"},
                "ports": {"$ref": "#/definitions/ports"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"breakGlass": {"properties": {"enabled": {"const": true}}}}},
      "then": {"anyOf": [
        {"properties": {"server": {"properties": {"sso": {"properties": {"oidc": {"properties": {"enabled": {"const": true}}}}}}}}},
        {"properties": {"server": {"properties": {"sso": {"properties": {"githubOAuth": {"properties": {"enabled": {"const": true}}}}}}}}}
      ]}
    },
    {
      "if": {"properties": {"server": {"properties": {"scim": {"properties": {"enabled": {"const": true}}}}}}},
      "then": {"properties": {
        "secrets": {"properties": {"scim": {"properties": {"name": {"$ref": "#/definitions/kubernetesObjectName"}}}}},
        "server": {"properties": {"sso": {"properties": {"publicURL": {"$ref": "#/definitions/httpsURL"}}}}}
      }}
    },
    {
      "if": {"properties": {"server": {"properties": {"sso": {"properties": {"oidc": {"properties": {"enabled": {"const": true}}}}}}}}},
      "then": {"properties": {
        "secrets": {"properties": {"oidc": {"properties": {"name": {"$ref": "#/definitions/kubernetesObjectName"}}}}},
        "server": {"properties": {"sso": {"properties": {
          "publicURL": {"$ref": "#/definitions/httpsURL"},
          "oidc": {"properties": {"issuerURL": {"$ref": "#/definitions/httpsURL"}, "clientID": {"$ref": "#/definitions/nonEmptyString"}, "linkClaim": {"$ref": "#/definitions/nonEmptyString"}}}
        }}}}
      }}
    },
    {
      "if": {"properties": {"server": {"properties": {"sso": {"properties": {"githubOAuth": {"properties": {"enabled": {"const": true}}}}}}}}},
      "then": {"properties": {
        "secrets": {"properties": {"githubOAuth": {"properties": {"name": {"$ref": "#/definitions/kubernetesObjectName"}}}}},
        "server": {"properties": {"sso": {"properties": {
          "publicURL": {"$ref": "#/definitions/httpsURL"},
          "githubOAuth": {"properties": {"clientID": {"$ref": "#/definitions/nonEmptyString"}}}
        }}}}
      }}
    },
    {
      "if": {"properties": {"networkPolicy": {"properties": {"externalEgress": {"properties": {"enabled": {"const": true}}}}}, "server": {"properties": {"sso": {"properties": {"oidc": {"properties": {"enabled": {"const": true}}}}}}}}},
      "then": {"properties": {"networkPolicy": {"properties": {"externalEgress": {"properties": {"identityProvider": {"properties": {"cidrs": {"minItems": 1}}}}}}}}}
    },
    {
      "if": {
        "properties": {
          "scanner": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "properties": {
              "scanner": {
                "$ref": "#/definitions/image"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "className": {
                "$ref": "#/definitions/kubernetesObjectName"
              },
              "hosts": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "externalEgress": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "externalEgress": {
                "properties": {
                  "dns": {
                    "properties": {
                      "namespaceSelector": {
                        "$ref": "#/definitions/nonEmptySelector"
                      },
                      "podSelector": {
                        "$ref": "#/definitions/nonEmptySelector"
                      }
                    }
                  },
                  "postgresql": {
                    "properties": {
                      "cidrs": {
                        "minItems": 1
                      }
                    }
                  },
                  "github": {
                    "properties": {
                      "cidrs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "optionalDnsLabel": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/definitions/dnsLabel"
        }
      ]
    },
    "kubernetesObjectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "optionalKubernetesObjectName": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/definitions/kubernetesObjectName"
        }
      ]
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[-._a-zA-Z0-9]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "quantity": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "@|:latest$"
          }
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "optionalImage": {
      "oneOf": [
        {
          "$ref": "#/definitions/image"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest",
            "tag",
            "pullPolicy"
          ],
          "properties": {
